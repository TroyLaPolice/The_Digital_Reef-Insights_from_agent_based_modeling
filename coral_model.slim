reproduction()
{
	// ---------------------------------------------------
	//  MATING --> Individuals mate with those close by
	// ---------------------------------------------------
	
	// creates a vector of neighboring individuals, within the max distance
	neighbors = i1.nearestInteractingNeighbors(individual, p1.individuals.length());
	
	if (individual.age >= 8) // If coral is of sexual maturity
	{
		possible_mates = neighbors[neighbors.age >= 8];  // Exclude mates not of sexual maturity
		
		cer_possible_mates = possible_mates[possible_mates.z == 0]; // cervicornis neighbors of reproductive age
		num_cer_possible_mates = cer_possible_mates.length();  // number of cervicornis neighbors of reproductive age
		
		pal_possible_mates = possible_mates[possible_mates.z == 1]; // palmata neighbors of reproductive age
		num_pal_possible_mates = pal_possible_mates.length();  // number of palmata neighbors of reproductive age
		
		pro_possible_mates = possible_mates[possible_mates.z == 2]; // prolifera neighbors of reproductive age
		num_pro_possible_mates = pro_possible_mates.length();  // number of prolifera neighbors of reproductive age
		
		if ((num_pal_possible_mates + num_cer_possible_mates + num_pro_possible_mates) == 0)
			no_mates = T;
		else
			no_mates = F;
		
		if (no_mates == F) // Runs if there are possible mates near by
		{
			if (individual.z == 0) // if individual is cervicornis
			{
				cer_weight = (num_cer_possible_mates) / (num_cer_possible_mates + ((num_pal_possible_mates + gamma * num_pro_possible_mates) * (1-cer_csp)));
				pal_weight = (num_pal_possible_mates * (1-cer_csp)) / (num_cer_possible_mates + ((num_pal_possible_mates + gamma*num_pro_possible_mates) * (1-cer_csp)));
				pro_weight = (num_pro_possible_mates * gamma * (1-cer_csp)) / (num_cer_possible_mates + ((num_pal_possible_mates + gamma*num_pro_possible_mates) * (1-cer_csp)));
			}
			else if (individual.z == 1) // if individual is palmata
			{
				pal_weight = (num_pal_possible_mates) / (num_pal_possible_mates + ((num_cer_possible_mates + gamma * num_pro_possible_mates) * (1-pal_csp)));
				cer_weight = (num_cer_possible_mates * (1-pal_csp)) / (num_pal_possible_mates + ((num_cer_possible_mates + gamma*num_pro_possible_mates) * (1-pal_csp)));
				pro_weight = (num_pro_possible_mates * gamma * (1-pal_csp)) / (num_pal_possible_mates + ((num_cer_possible_mates + gamma*num_pro_possible_mates) * (1-pal_csp)));
			}
			else if (individual.z == 2) // if individual is prolifera
			{
				pro_weight = (num_pro_possible_mates * gamma) / ((num_pro_possible_mates * gamma) + (num_cer_possible_mates + num_pal_possible_mates));
				pal_weight = (num_pal_possible_mates) / ((num_pro_possible_mates * gamma) + (num_cer_possible_mates + num_pal_possible_mates));
				cer_weight = (num_cer_possible_mates) / ((num_pro_possible_mates * gamma) + (num_cer_possible_mates + num_pal_possible_mates));
			}
			
			weights_vector = c(cer_weight, pal_weight, pro_weight);
			mate_species_choices = c(0, 1, 2); // Vector of choices (0 = cervicornis, 1 = palmata, 2 = prolifera)
			mate_species = sample(mate_species_choices, 1, weights=weights_vector); // Select from choices
			
			if (mate_species == 0) // mate is cervicornis
			{
				if (num_cer_possible_mates != 0)
				{
					mate = sample(cer_possible_mates, 1); // sample a cervicornis
				}
				else
					mate = NULL; // If no mates possible, NULL
			}
			else if (mate_species == 1) // mate is palmata 
			{
				if (num_pal_possible_mates != 0)
				{
					mate = sample(pal_possible_mates, 1); // sample a palmata
				}
				else
					mate = NULL; // If no mates possible, NULL
			}
			else if (mate_species == 2) // mate is prolifera
			{
				if (num_pro_possible_mates != 0)
				{
					mate = sample(pro_possible_mates, 1); // sample a prolifera
				}
				else
					mate = NULL; // If no mates possible, NULL
			}
		}
		else
			mate = NULL; // If no mates possible, NULL
		
		if (isNULL(mate) != T)
		{
			// Determine an intital offspring postion based to initalize the individual before dispersal step below
			pos = individual.spatialPosition;
			
			// ---------------------------------------------------
			//  MOVEMENT --> How larvae disperse
			// ---------------------------------------------------
			// Normal multivariate distribution dictating dispersal to pick new coordinates in the movement range
			coordinate_matrix = rmvnorm(1, c(meanX, meanY), matrix(c(SDX^2, 0, 0, SDY^2), nrow=2));
			coordinates = c(coordinate_matrix[0], coordinate_matrix[1]);
			
			// Determine the new positional coordinates
			newPos = individual.spatialPosition + coordinates;
			
			if (p1.pointInBounds(newPos) & p1.spatialMapValue("map_object", newPos) != 0.0) // Only generates an offspring if density is below K and point is on a suitable reef
			{
				// Generates an offspring
				offspring = subpop.addCrossed(individual, mate);
				offspring.setSpatialPosition(newPos); // Set settle point for offspring
				
				// Define z param in offspring (phenotype, 0 = cervicornis, 1 = palmata, 2 == prolifera)
				offspring.z = 0;
				
				// Determine percent ancestry in offspring
				ancestry = offspring.countOfMutationsOfType(m1) / (sim.chromosome.lastPosition * 2 + 2);
				
				// Determine the genotype at the speciation loci
				species_loci = offspring.countOfMutationsOfType(m2);
				
				// Determine species of the offspring based on ancestry threshold
				if (species_loci >= 162)
					offspring.z = 1; // offspring is palmata
				else if (species_loci <= 18)
					offspring.z = 0; // offspring is cervicornis
				else
					offspring.z = 2; // offspring is prolifera
				
				if (offspring.z == 0) // offspring is cervicornis
					mortality_prob = c(1 - success_cer, (success_cer)); // Probability of survival
				else if (offspring.z == 1) // offspring is palmata 
					mortality_prob = c(1 - success_pal, (success_pal)); // Probability of survival
				else if (offspring.z == 2) // offspring is prolifera
					mortality_prob = c(1 - success_pro, (success_pro)); // Probability of survival
				
				// Most indiviudals will not survive and settle
				choices = c(0, 1); // Vector of choices, will the individual die (0) or survive (1)
				mortality = sample(choices, 1, weights=mortality_prob); // Select from choices
				
				if (mortality == 0)
					offspring.fitnessScaling = 0;
				
				
				if (Color_scheme == 1) // Coloring in GUI of individuals
				{
					// --------------------------------
					// Color Based on Discrete Species
					// --------------------------------
					// Add color to represent phenotype
					if (offspring.z == 0) // cervicornis
						offspring.color = "red"; //cervicornis = red
					else if (offspring.z == 1) // palmata
						offspring.color = "blue"; //palmata = blue
					else if (offspring.z == 2) // prolifera
						offspring.color = "green"; // prolifera = green
				}
				else
				{
					// -------------------------------
					// Color Based on Percent Ancestry
					// -------------------------------
					// Calculate percent ancestry
					ancestry = offspring.countOfMutationsOfType(m1) / (sim.chromosome.lastPosition * 2 + 2);
					
					// Color as a gradient based on the percent ancestry
					offspring.color = rgb2color(hsv2rgb(c(0.6, 1.0, ancestry)));
				}
				
				// Count all neighbors to the location where the offspring settled
				neighbors = i2.nearestNeighborsOfPoint(newPos, p1, count=p1.individuals.length());
				num_neighbors = neighbors.length();
				
				// Determine the species composition of the neighbors
				palmata_neighbors = neighbors[neighbors.z == 1.0];
				cervicornis_neighbors = neighbors[neighbors.z == 0.0];
				prolifera_neighbors = neighbors[neighbors.z == 2.0];
				
				// If the local densitiy is >= to the K for the species that the offspring is, the settle will not be sucessful and the offspring larvae will die
				if (offspring.z == 1.0)
				{
					num_pal_neighbors = palmata_neighbors.length(); // Number of other palmata individuals surrounding new palmata larvae
					num_other_neighbors = (num_neighbors - num_pal_neighbors); // Number of other non-palmata individuals surrounding new palmata larvae
					neighbors_counting_towards_K = (num_pal_neighbors + (num_other_neighbors * other_species_compete)); // Count based on the level of competition with other species, calculate the effective local density for new palmata larvea
					if (neighbors_counting_towards_K >= (PI * S^2 * parentalK)) // If the effective local density is larger than expected K
						offspring.fitnessScaling = 0.0; // Larvae will not settle effectively
				}
				
				if (offspring.z == 0.0)
				{
					num_cer_neighbors = cervicornis_neighbors.length(); // Number of other cervicornis individuals surrounding new cervicornis larvae
					num_other_neighbors = (num_neighbors - num_cer_neighbors); // Number of other non-cervicornis individuals surrounding new cervicornis larvae
					neighbors_counting_towards_K = (num_cer_neighbors + (num_other_neighbors * other_species_compete)); // Count based on the level of competition with other species, calculate the effective local density for new cervicornis larvea
					if (neighbors_counting_towards_K >= (PI * S^2 * parentalK)) // If the effective local density is larger than expected K
						offspring.fitnessScaling = 0.0; // Larvae will not settle effectively
				}
				
				if (offspring.z == 2.0)
				{
					num_pro_neighbors = prolifera_neighbors.length(); // Number of other prolifera individuals surrounding new prolifera larvae
					num_other_neighbors = (num_neighbors - num_pro_neighbors); // Number of other non-prolifera individuals surrounding new prolifera larvae
					neighbors_counting_towards_K = num_neighbors; // Prolifera has to fight for space against the parentals so it competes with all for an intermediate niche
					if (neighbors_counting_towards_K >= (PI * S^2 * proK)) // If the effective local density is larger than expected K
						offspring.fitnessScaling = 0.0; // Larvae will not settle effectively
				}
			
			}
		}
	}
	
	// ------------------------------------------------------------------------------------
	//  Clonal Reproduction ---> Random clonal events to simulated stochastic fragmentation
	// ------------------------------------------------------------------------------------
	// Generate offspring that will reproduce based on above rate determination
	if (individual.age > 2)
	{
		if (rbinom(1, 1, clone_rate) == 1)
		{
			// Normal multivariate distribution dictating dispersal to pick new coordinates in the movement range
			coordinate_matrix = rmvnorm(1, c(meanX, meanY), matrix(c(clonal_SDX^2, 0, 0, clonal_SDY^2), nrow=2));
			coordinates = c(coordinate_matrix[0], coordinate_matrix[1]);
			
			// Determine the new positional coordinates
			newPos = individual.spatialPosition + coordinates;
			
			if (p1.pointInBounds(newPos) & p1.spatialMapValue("map_object", newPos) != 0.0)
			{
				// Generates an offspring
				offspring = subpop.addCloned(individual);
				offspring.age = 2; // It is a partially grown fragment so set its age > 0 
				offspring.setSpatialPosition(newPos); // Set settle point for offspring
				
				// Define z param in offspring (phenotype, 0 = cervicornis, 1 = palmata, 2 == prolifera)
				offspring.z = 0;
				
				// Determine percent ancestry in offspring
				ancestry = offspring.countOfMutationsOfType(m1) / (sim.chromosome.lastPosition * 2 + 2);
				
				// Determine the genotype at the speciation loci
				species_loci = offspring.countOfMutationsOfType(m2);
				
				// Determine species of the offspring based on ancestry threshold
				if (species_loci >= 162)
					offspring.z = 1; // offspring is palmata
				else if (species_loci <= 18)
					offspring.z = 0; // offspring is cervicornis
				else
					offspring.z = 2; // offspring is prolifera
				
				
				if (Color_scheme == 1) // Coloring in GUI of individuals
				{
					// --------------------------------
					// Color Based on Discrete Species
					// --------------------------------
					// Add color to represent phenotype
					if (offspring.z == 0) // cervicornis
						offspring.color = "red"; //cervicornis = red
					else if (offspring.z == 1) // palmata
						offspring.color = "blue"; //palmata = blue
					else if (offspring.z == 2) // prolifera
						offspring.color = "green"; // prolifera = green
				}
				else
				{
					// -------------------------------
					// Color Based on Percent Ancestry
					// -------------------------------
					// Calculate percent ancestry
					ancestry = offspring.countOfMutationsOfType(m1) / (sim.chromosome.lastPosition * 2 + 2);
					
					// Color as a gradient based on the percent ancestry
					offspring.color = rgb2color(hsv2rgb(c(0.6, 1.0, ancestry)));
				}
				
				// Count all neighbors to the location where the offspring settled
				neighbors = i2.nearestNeighborsOfPoint(newPos, p1, count=p1.individuals.length());
				num_neighbors = neighbors.length();
				
				// Determine the species composition of the neighbors
				palmata_neighbors = neighbors[neighbors.z == 1.0];
				cervicornis_neighbors = neighbors[neighbors.z == 0.0];
				prolifera_neighbors = neighbors[neighbors.z == 2.0];
				
				// If the local densitiy is >= to the K for the species that the offspring is, the settle will not be sucessful and the offspring fragment will die
				if (offspring.z == 1.0)
				{
					num_pal_neighbors = palmata_neighbors.length(); // Number of other palmata individuals surrounding new palmata fragment
					num_other_neighbors = (num_neighbors - num_pal_neighbors); // Number of other non-palmata individuals surrounding new palmata fragment
					neighbors_counting_towards_K = (num_pal_neighbors + (num_other_neighbors * other_species_compete)); // Count based on the level of competition with other species, calculate the effective local density for new palmata larvea
					if (neighbors_counting_towards_K >= (PI * S^2 * parentalK)) // If the effective local density is larger than expected K
						offspring.fitnessScaling = 0.0; // Fragment will not settle effectively
				}
				
				if (offspring.z == 0.0)
				{
					num_cer_neighbors = cervicornis_neighbors.length(); // Number of other cervicornis individuals surrounding new cervicornis fragment
					num_other_neighbors = (num_neighbors - num_cer_neighbors); // Number of other non-cervicornis individuals surrounding new cervicornis fragment
					neighbors_counting_towards_K = (num_cer_neighbors + (num_other_neighbors * other_species_compete)); // Count based on the level of competition with other species, calculate the effective local density for new cervicornis larvea
					if (neighbors_counting_towards_K >= (PI * S^2 * parentalK)) // If the effective local density is larger than expected K
						offspring.fitnessScaling = 0.0; // Fragment will not settle effectively
				}
				
				if (offspring.z == 2.0)
				{
					num_pro_neighbors = prolifera_neighbors.length(); // Number of other prolifera individuals surrounding new prolifera fragment
					num_other_neighbors = (num_neighbors - num_pro_neighbors); // Number of other non-prolifera individuals surrounding new prolifera fragment
					neighbors_counting_towards_K = num_neighbors; // Prolifera has to fight for space against the parentals so it competes with all for an intermediate niche
					if (neighbors_counting_towards_K >= (PI * S^2 * proK)) // If the effective local density is larger than expected K
						offspring.fitnessScaling = 0.0; // Fragment will not settle effectively
				}
			}
			
			// Set age of parental back as a proxy for them losing mass to fragmentation
			current_parent_age = individual.age;
			new_parent_age = (current_parent_age - 2);
			
			if (new_parent_age <= 0)
			{
				individual.fitnessScaling = 0.0; // If the entire coral fragments off the orignal parental individual will die
				break;
			}
			else
			{
				individual.age = new_parent_age;
			}
		}
	}
}

early()
{
	// --------------------------------------------------------------------------------
	//  MORTALITY ---> Random mortality events to simulated stochastic processes
	// --------------------------------------------------------------------------------
	i1.evaluate(sim.subpopulations);
	inds = p1.individuals; // Get vector of individuals in the population
	if (bleaching_simulation == 1)
	{
		// Bleaching event or not?
		// Starting with 2016 bleaching rate calculate the current bleaching probability
		// Frequency of bleaching increases each year by 4%
		new_bleaching_rate = (bleaching_rate + (bleaching_rate * 0.04));
		
		// Can't be larger than 100% of the time
		if (new_bleaching_rate > 1)
			new_bleaching_rate = 1;
		
		// Redefine the global value with updated value	
		defineGlobal("bleaching_rate", new_bleaching_rate);
		bleaching_prob = c(new_bleaching_rate, (1 - new_bleaching_rate)); // Probability of bleaching summer
		choices = c(0, 1); // Vector of choices, will be a bleaching event (0) or not (1)
		bleaching_year = sample(choices, 1, weights=bleaching_prob); // Select from choices
		
		// In especially warm summers, bleaching mortality will be higher
		// In sim, every bleaching year, there will be higher mortality
		if (bleaching_year == 0)
		{
			motality_rate = base_adult_mortality_rate * motality_rate_elevation; // Elevated population morality rate in warm summer
			
			// Loop through individuals in population and check for beneficial mutations, modify fitness accordingly
			for (ind in inds)
			{
				if (ind.countOfMutationsOfType(m3) == 1) // If ind is heterozygous for beneficial mutation
					
					// Individual is partially resistant due to heterozygous for beneficial mutation
					new_motality_rate = (motality_rate * ((1 - heat_resistant_mortality_modifier))); // having one copy reduces mortality chance by <heat_resistant_mortality_modifier>
				else if (ind.countOfMutationsOfType(m3) == 2) // If ind is homozygous for beneficial mutation
					new_motality_rate = (motality_rate * ((1 - heat_resistant_mortality_modifier)^2)); // having two copies reduces by double <heat_resistant_mortality_modifier>
				else
					new_motality_rate = motality_rate;
				mortality_prob = c(new_motality_rate, (1 - new_motality_rate)); // Probability of survival
				choices = c(0, 1); // Vector of choices, will the individual die (0) or survive (1)
				mortality = sample(choices, 1, weights=mortality_prob); // Select from choices
				
				// If individual dies in bleaching event, set fitness to zero
				if (mortality == 0)
					ind.fitnessScaling = 0;
			}
		}
		else
		{
			
			// If evolutionary trade off is on
			
			if (evol_trade == 1)
			{
				// If not a heavy bleaching year, beneficial mutation does not confer selective advantage
				motality_rate = base_adult_mortality_rate;
				
				// Loop through individuals in population and check for beneficial mutations, modify fitness accordingly
				for (ind in inds)
				{
					if (ind.countOfMutationsOfType(m3) == 1) // If ind is heterozygous for beneficial mutation
						
						// Individual is partially resistant to bleaching due to heterozygous for beneficial mutation but will suffer partitally increased mortality otherwise
						new_motality_rate = (motality_rate * ((1 + heat_resistant_mortality_modifier))); // having one copy increases mortality chance by <heat_resistant_mortality_modifier> (evolutionary tradeoff)
					else if (ind.countOfMutationsOfType(m3) == 2) // If ind is homozygous for beneficial mutation
						
						// Individual is resistant to bleaching but will suffer increased mortality otherwise (evolutionary tradeoff)
						new_motality_rate = (motality_rate * ((1 + heat_resistant_mortality_modifier)^2)); // having two copies increases by double <heat_resistant_mortality_modifier> (evolutionary tradeoff)
					else
						new_motality_rate = motality_rate;
					mortality_prob = c(new_motality_rate, (1 - new_motality_rate)); // Probability of survival
					choices = c(0, 1); // Vector of choices, will the individual die (0) or survive (1)
					mortality = sample(choices, 1, weights=mortality_prob); // Select from choices
					
					// If individual dies in bleaching event, set fitness to zero
					if (mortality == 0)
						ind.fitnessScaling = 0;
				}
			}
			else
			{
				// Loop through individuals in population and scale mortality
				for (ind in inds)
				{
					new_motality_rate = base_adult_mortality_rate;
					mortality_prob = c(new_motality_rate, (1 - new_motality_rate)); // Probability of survival
					choices = c(0, 1); // Vector of choices, will the individual die (0) or survive (1)
					mortality = sample(choices, 1, weights=mortality_prob); // Select from choices
					
					// If individual dies in bleaching event, set fitness to zero
					if (mortality == 0)
						ind.fitnessScaling = 0;
				}
			
			}
		}
	}
	else // If dynamic bleaching is not selected simple mortality below is used
	{
		// Loop through individuals in population and scale mortality
		for (ind in inds)
		{
			new_motality_rate = base_adult_mortality_rate;
			mortality_prob = c(new_motality_rate, (1 - new_motality_rate)); // Probability of survival
			choices = c(0, 1); // Vector of choices, will the individual die (0) or survive (1)
			mortality = sample(choices, 1, weights=mortality_prob); // Select from choices
			
			// If individual dies in bleaching event, set fitness to zero
			if (mortality == 0)
				ind.fitnessScaling = 0;
		}
	}
}

late()
{
	// ------------------------------------------------------------
	//  Every 20 Years Sample individuals to get ancestry distribution
	// ------------------------------------------------------------
	
	if (sim.cycle % 20 == 0) // Runs every 20 years and samples individuals in population to get ancestry sample
	{
		
		sample_size = 1000;
		
		if (p1.individuals.length() < 1000)
			sample_size = p1.individuals.length();
		
		selected_inds = sample(p1.individuals, sample_size); // Select inds from pop to sample ancestry
		
		for (ind in selected_inds) // For each of the selected inds
		{
			// Determine species of the individual for output
			if (ind.z == 0.0)
				species = "cervicornis";
			if (ind.z == 1.0)
				species = "palmata";
			if (ind.z == 2.0)
				species = "prolifera";
			
			// Write output
			output_ancestry_sample_string = paste(sim.cycle, ind, species, (ind.countOfMutationsOfType(m1) / (sim.chromosome.lastPosition * 2 + 2)), ind.x, ind.y, ind.age, sep=",");
			output_ancestry_sample_file_name = ("/sim_ancestry_sample_" + output_name + ".csv");
			writeFile(wd + output_ancestry_sample_file_name, output_ancestry_sample_string, append=T);
		
		}
	}
}

1:1000 late()
{
	// -------------------------------------------
	//  Each Year ---> Output stats to files
	// -------------------------------------------
	// provide feedback on progress for command line users
	year_counter = paste("Simulation Year: ", sim.cycle);
	print(year_counter);
	
	// define vector of palmata, vector of cervicornis, vector of prolifera
	palmata = p1.individuals[p1.individuals.z == 1];
	cervicornis = p1.individuals[p1.individuals.z == 0];
	prolifera = p1.individuals[p1.individuals.z == 2];
	
	// calculate num palmata
	num_palmata = length(palmata);
	
	//calculate num cervicornis
	num_cervicornis = length(cervicornis);
	
	//calculate num prolifera
	num_prolifera = length(prolifera);
	
	// calculate the ratio of palmata in the total population to file
	ratio = (num_palmata / num_cervicornis);
	
	// calculate population size statistics
	pop_size = p1.individuals.length();
	
	// calculate the cervicornis ancestry in all palmata
	if (length(palmata) != 0)
		cervicornis_ancestry_palmata = (1 - (mean(palmata.countOfMutationsOfType(m1) / (sim.chromosome.lastPosition * 2 + 2))));
	else
		cervicornis_ancestry_palmata = 0.0;
	
	// calculate the palmata ancestry in all cervicornis
	if (length(cervicornis) != 0)
		palmata_ancestry_cervicornis = mean(cervicornis.countOfMutationsOfType(m1) / (sim.chromosome.lastPosition * 2 + 2));
	else
		palmata_ancestry_cervicornis = 0.0;
	
	// calculate the palmata ancestry in all prolifera
	if (length(prolifera) != 0)
		palmata_ancestry_prolifera = mean(prolifera.countOfMutationsOfType(m1) / (sim.chromosome.lastPosition * 2 + 2));
	else
		palmata_ancestry_prolifera = 0.0;
	
	// calculate the cervicornis ancestry in all prolifera
	if (length(prolifera) != 0)
		cervicornis_ancestry_prolifera = (1 - (mean(prolifera.countOfMutationsOfType(m1) / (sim.chromosome.lastPosition * 2 + 2))));
	else
		cervicornis_ancestry_prolifera = 0.0;
	
	// calculate the number of beneficial mutations that have introgressed into prolifera
	if (length(prolifera) != 0)
		beneficial_in_pro = mean(prolifera.countOfMutationsOfType(m3));
	else
		beneficial_in_pro = 0.0;
	
	// calculate the number of beneficial mutations that have introgressed into palmata
	if (length(palmata) != 0)
		beneficial_in_pal = mean(palmata.countOfMutationsOfType(m3));
	else
		beneficial_in_pal = 0.0;
	
	// calculate the number of beneficial mutations that have introgressed into cervicornis
	if (length(cervicornis) != 0)
		beneficial_in_cer = mean(cervicornis.countOfMutationsOfType(m3));
	else
		beneficial_in_cer = 0.0;
	
	// write outputs
	output_string = paste(sim.cycle, pop_size, num_palmata, num_cervicornis, num_prolifera, ratio, cervicornis_ancestry_palmata, palmata_ancestry_cervicornis, palmata_ancestry_prolifera, cervicornis_ancestry_prolifera, beneficial_in_pro, beneficial_in_pal, beneficial_in_cer, bleaching_rate, sep=",");
	output_stats_file_name = ("/sim_pop_stats_per_year_" + output_name + ".csv");
	writeFile(wd + output_stats_file_name, output_string, append=T);
}
