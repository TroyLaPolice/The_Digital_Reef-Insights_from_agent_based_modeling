initialize()
{
	initializeSLiMModelType("nonWF");
	initializeSLiMOptions(dimensionality="xy", periodicity="xy");
	
	// ---------------------------------------------------
	//  PARAMETERS --> Initialize Constant Params
	// ---------------------------------------------------
	
	//SET WORKING DIRECTORY AND CUSTOM MAP NAME IF DESIRED
	if (!exists("wd"))
		defineConstant("wd", "/home/tml5905/Documents/CoralPopulationSimulation");
	if (!exists("custom_map_filename"))
		defineConstant("custom_map_filename", 0); // Parameter = file name of map (as string) if user wants to use their own map and override the built in maps, else == 0
	if (!exists("output_name"))
		defineConstant("output_name", "run1"); // To run default names make an empty string
	
	// Carrying Capacities, Mortality and Pop Sizes:
	// ***********************************
	if (!exists("DS"))
		defineConstant("DS", 1); // Down scale the simulation ( Must be >= 1)
	if (!exists("SN"))
		defineConstant("SN", integerDiv(100000, DS)); // Starting number of individuals
	if (!exists("other_species_compete"))
		defineConstant("other_species_compete", 0.0); // factor in how much overlap there is in parental habitat niches. 1 = full competition between all species, 0 = no between species competition (i.e., totally independent carrying capacities
	if (!exists("parentalK"))
		defineConstant("parentalK", 262 / DS); // carrying capacity for parental_species (ENTER IN INDIVIDUALS PER KM2) for density dependent scaling
	if (!exists("proK"))
		defineConstant("proK", ((2*parentalK-(other_species_compete*parentalK)) / DS)); // carrying capacity for prolifera (ENTER IN INDIVIDUALS PER KM2) for density dependent scaling
	if (!exists("base_adult_mortality_rate"))
		defineConstant("base_adult_mortality_rate", 0.01); // mortality rate in non-bleaching summers
	if (!exists("bleaching_simulation"))
		defineGlobal("bleaching_simulation", 0); // Decide if the simulation will have dynamic bleaching or not. 1 = yes 0 = no. The following parameters will not matter if 0 is slected: heat_resistant_mortality_modifier, motality_rate_elevation, evol_trade bleaching_rate
	if (!exists("heat_resistant_mortality_modifier"))
		defineConstant("heat_resistant_mortality_modifier", 0.5); // Beneficial mutation heat resistance mutation reduces the <mortality_rate> by <heat_resistant_mortality_modifier>
	if (!exists("motality_rate_elevation"))
		defineConstant("motality_rate_elevation", 2); // How much mortality increases in bleaching year. Must be >=1 (1 means no increased mortality as a result of warm summers)
	if (!exists("evol_trade"))
		defineConstant("evol_trade", 0); // If evolutionary tradeoff is turned on (= 1) then there will be a tradeoff to the benefical mutation in non-bleaching years
	if (!exists("bleaching_rate"))
		defineGlobal("bleaching_rate", 0.167); // Starting 2016 bleaching rate	
	if (!exists("initial_ratio"))
		defineConstant("initial_ratio", 0.5); // percentage of inital population that is palmata (used in initilization step of sim)
	
	// Movement and interaction and competition:
	// ***********************************
	if (!exists("SDX"))
		defineConstant("SDX", 10); // Movement standard diviation (sigma) for distribution of distances sampled from in the x direction (ENTER IN KILOMETERS)
	if (!exists("SDY"))
		defineConstant("SDY", 10); // Movement standard diviation (sigma) for distribution of distances sampled from in the y direction (ENTER IN KILOMETERS)
	if (!exists("clonal_SDX"))
		defineConstant("clonal_SDX", 0.5); // Movement standard diviation (sigma) for distribution of distances sampled from in the x direction (ENTER IN KILOMETERS)
	if (!exists("clonal_SDY"))
		defineConstant("clonal_SDY", 0.5); // Movement standard diviation (sigma) for distribution of distances sampled from in the y direction (ENTER IN KILOMETERS)
	if (!exists("meanX"))
		defineConstant("meanX", 0); // Movement mean for distribution of distances sampled from in the x direction (ENTER IN KILOMETERS)
	if (!exists("meanY"))
		defineConstant("meanY", 0); // Movement mean for distribution of distances sampled from in the y direction (ENTER IN KILOMETERS)
	if (!exists("S"))
		defineConstant("S", 1); // spatial competition distance (ENTER IN KILOMETERS)
	
	// Mating rate params:
	// ***********************************
	if (!exists("success_cer"))
		defineConstant("success_cer", 0.01); // success for cervicornis X cervicornis cross
	if (!exists("success_pal"))
		defineConstant("success_pal", 0.01); // success for palmata X palmata cross
	if (!exists("success_pro"))
		defineConstant("success_pro", 0.01); // success for hybrid cross. So how many successful offspring are possible if the parentage is mixed.
	if (!exists("clone_rate"))
		defineConstant("clone_rate", 0.02); // reproduction for clonal repro
	if (!exists("MD"))
		defineConstant("MD", 0.6); // Mating distance (ENTER IN KILOMETERS)
	if (!exists("cer_csp"))
		defineConstant("cer_csp", 0.03); // Conspecific sperm preference of cervicornis egg, 0.03 from Fogarty et al., 2012
	if (!exists("pal_csp"))
		defineConstant("pal_csp", 0.33); // Conspecific sperm preference of palmata egg, 0.333 from Fogarty et al., 2012
	if (!exists("gamma"))
		defineConstant("gamma", 1.0); // Down weighting of prolifera sperm success (1 = no down weighting)
	if (!exists("random_initial_settle"))
		defineConstant("random_initial_settle", 1); // 0 = non-random initial settle, 1 = random initial settle
	
	// ---------------------------------------------------
	// RUN TIME PREFERENCE PARAMETERS
	// ---------------------------------------------------
	// Determine Coloring Schemes:
	// ***********************************
	defineConstant("Color_scheme", 1); // Parameter of 0 = Genomic Coloring, 1 = Phenotypic Coloring
	
	// Map Prefs:
	// ***********************************
	if (!exists("map_style"))
		defineConstant("map_style", 0); // 0 = simple, 1 = Laughing Bird Caye, 6 = custom map
	defineConstant("file_extention", ".png");
	defineConstant("simple", wd + "/simple.png"); // File Path to Map Image
	defineConstant("LaughingBirdCaye", wd + "/laughing_bird_caye.png"); // File Path to Map Image
	
	// Map citation: https://www.laughingbird.org/park2.html
	defineConstant("custom_map", wd + custom_map_filename); // File Path to Map Image
	
	// Map Dimensions of 8.96km x 12.964km Based on laughingbird.org map
	if (!exists("map_size_length"))
		defineConstant("map_size_length", 12.964);
	if (!exists("map_size_width"))
		defineConstant("map_size_width", 8.96);
	
	// ----------------------------------------------------
	//  GENETIC COMPONENT --> Initialize Genomic Elements
	// ----------------------------------------------------
	initializeMutationType("m1", 0.5, "f", 0.0); // Tag palmata ancestry
	m1.convertToSubstitution = F;
	initializeGenomicElementType("g1", m1, 1.0);
	initializeGenomicElement(g1, 0, 267); // Genome Size in MB
	initializeMutationType("m2", 0.5, "f", 0.0); // Speciation Loci
	m2.convertToSubstitution = F;
	initializeMutationRate(0.0); // Zero Mutations
	initializeMutationType("m3", 0.8, "e", 0.5); // beneficial mutation to be added to single parent species to see if it can cross into prolifera
	rates = c(0.0447, 0.5, 0.0359, 0.5, 0.05, 0.5, 0.0453, 0.5, 0.05, 0.5, 0.0419, 0.5, 0.0505, 0.5, 0.0469, 0.5, 0.0424, 0.5, 0.0518, 0.5, 0.0542, 0.5, 0.0501, 0.5, 0.041, 0.5, 0.0632);
	ends = c(27, 28, 54, 55, 76, 77, 95, 96, 115, 116, 136, 137, 152, 153, 167, 168, 186, 187, 205, 206, 222, 223, 239, 240, 253, 254, 267); // Recombination Rates and Chromosome Initialization
	initializeRecombinationRate(rates, ends);
	
	// ---------------------------------------------------
	//  INTERACTIONS --> Interaction Initialization
	// ---------------------------------------------------
	// spatial mate choice
	initializeInteractionType(1, "xy", reciprocal=T, maxDistance=MD);
	initializeInteractionType(2, "xy", reciprocal=T, maxDistance=S);
}

1 early()
{
	sim.addSubpop("p1", SN); // Initialize population based on starting number of individuals
	
	p1.individuals.age = 4; // sets population ages to the age when they would be outplanted as fragments
}

2: first()
{
	i1.evaluate(p1); // Initialize mating interaction
	i2.evaluate(p1); // Initialize competition interaction
}

